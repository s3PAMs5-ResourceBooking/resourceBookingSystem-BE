# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Bez tych wartości logowanie przez Google/GitHub nie działa, reszta środowiska tak.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sekret klienta reservation-backend (Keycloak Admin API, etap 9)
KEYCLOAK_BACKEND_CLIENT_SECRET=dev-backend-secret
