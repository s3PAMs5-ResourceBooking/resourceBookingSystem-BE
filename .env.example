# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.
# Lokalnie wszystko ma wartości domyślne — .env potrzebny tylko dla Google/GitHub.
# Na VPS ustaw każdą wartość (silne hasła).

# Logowanie przez Google/GitHub — bez tych wartości reszta środowiska działa
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Sekret klienta reservation-backend (Keycloak Admin API, etap 9)
KEYCLOAK_BACKEND_CLIENT_SECRET=dev-backend-secret

# --- tylko VPS ---
POSTGRES_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
# adres Keycloak widziany przez przeglądarkę; przy tunelu SSH zostaw localhost,
# po podpięciu domeny np. https://auth.twojadomena.duckdns.org
KEYCLOAK_PUBLIC_URL=http://localhost:8180
# ustawiane automatycznie przez workflow Deploy
BACKEND_IMAGE=
